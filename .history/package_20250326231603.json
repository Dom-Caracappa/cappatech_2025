{
  "name": "cappatech_2025",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter main-site dev",
    "dev:admin": "pnpm --filter admin-panel dev",
    "dev:blog": "pnpm --filter blog-site dev",
    "build": "pnpm --filter main-site build",
    "build:admin": "pnpm --filter admin-panel build",
    "build:blog": "pnpm --filter blog-site build",
    "start": "pnpm --filter main-site preview ",
    "generate:project": "pnpm ts-node generateProjectJson.ts",
    "fix-dependencies": "pnpm ts-node fixDependencies.ts",
    "setup": "ts-node setup-cli.ts",
    "cli:build": "tsc cappa-cli/cli.ts --outDir dist",
    "cli": "pnpm cli:build && node dist/cli.js",
    "db:generate": "pnpm drizzle-kit generate",
    "db:push": "pnpm drizzle-kit push",
    "db:reset": "pnpm drizzle-kit push --force",
    "db:seed": "pnpm tsx server/db/seed.ts"
  },
  "bin": {
    "cappatech": "./dist/cli.js"
  },
  "workspaces": [
    "main-site",
    "admin-panel",
    "cappa-cli",
    "server"
  ],
