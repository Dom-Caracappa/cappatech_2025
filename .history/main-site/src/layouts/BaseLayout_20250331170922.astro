---
const { title = "CappaTech", description = "", children } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="bg-sky-400 text-white font-sans">
        <slot />
        <!-- This will render child page content -->
    </body>
</html>
