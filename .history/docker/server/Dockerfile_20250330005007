# Use a lightweight Node.js base image
FROM node:20-alpine

# Install required build tools for native modules
RUN apk add --no-cache python3 make g++ 

# Set working directory inside the container
WORKDIR /app

# Copy your app code
COPY ./server/app ./app

# Install pnpm globally
RUN npm install -g pnpm

# Install dependencies WITH build tools
RUN pnpm install --ignore-scripts && pnpm rebuild better-sqlite3

# Switch to working directory where server code is
WORKDIR /app

# Expose port
EXPOSE 5042

# Start the server
CMD ["pnpm", "exec", "tsx", "index.mts"]
