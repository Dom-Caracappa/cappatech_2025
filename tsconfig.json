{
    "type": "module",
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "outDir": "dist",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESNext",
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": false,
        "esModuleInterop": true,
        "sourceMap": true,
        "declaration": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "lib": [
            "DOM",
            "ESNext",
            "DOM.Iterable"
        ],
        "jsxImportSource": "react",
        "strict": true,
        "skipLibCheck": true
    },
    "ts-node": {
        "esm": true
    },
    "include": [
        "cappa-cli/**/*.ts",
        "src/**/*.ts",
        "**/*.ts",
        "**/*.tsx",
        "astro-env.d.ts",
        "cappa-graphql/src/db/drizzle.mts",
        "cappa-graphql/src/index.mts",
        "server/graphql/resolvers/formResolvers.mts",
        "server/graphql/typeDefs/formTypeDefs.mts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}